{
  "rules": {

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },

    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",

        "role": {
          ".validate": "newData.val() === 'buyer' || newData.val() === 'seller'"
        },

        "status": {
          ".write": "auth != null && ( (auth.uid === $uid && !data.exists()) || root.child('admins').child(auth.uid).exists() )",
          ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected' || newData.val() === 'suspended'"
        }
      }
    },

    "properties": {
      ".read": true,
      ".indexOn": ["sellerId", "listingType"],
      "$propertyId": {
        ".write": "auth != null && ( root.child('admins').child(auth.uid).exists() || (data.exists() && data.child('sellerId').val() === auth.uid) || (!data.exists() && newData.child('sellerId').val() === auth.uid && root.child('users').child(auth.uid).child('role').val() === 'seller' && root.child('users').child(auth.uid).child('status').val() === 'approved') )"
      }
    },

    "chats": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$chatId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && ( (!data.exists() && (newData.child('buyerId').val() === auth.uid || newData.child('sellerId').val() === auth.uid)) || data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists() )"
      }
    },

    "userChats": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "$chatId": {
          ".write": "auth != null && newData.val() === true"
        }
      }
    },

    "messages": {
      "$chatId": {
        ".read": "auth != null && (root.child('chats').child($chatId).child('buyerId').val() === auth.uid || root.child('chats').child($chatId).child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        "$messageId": {
          ".write": "auth != null && newData.child('senderId').val() === auth.uid && (root.child('chats').child($chatId).child('buyerId').val() === auth.uid || root.child('chats').child($chatId).child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
        }
      }
    },

    "offers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$offerId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && ( (!data.exists() && newData.child('buyerId').val() === auth.uid) || data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists() )"
      }
    },

    "userOffers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "$offerId": {
          ".write": "auth != null && newData.val() === true"
        }
      }
    },

    "userPropertyOffers": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())"
      }
    },

    "transactions": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$transactionId": {
        ".read": "auth != null && (data.child('buyerId').val() === auth.uid || data.child('sellerId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },

    "userTransactions": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "$transactionId": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        }
      }
    },

    "reviews": {
      ".read": true,
      ".indexOn": ["sellerId", "buyerId"],
      "$reviewId": {
        ".write": "auth != null && ( root.child('admins').child(auth.uid).exists() || (!data.exists() && newData.child('buyerId').val() === auth.uid && root.child('transactions').child(newData.child('transactionId').val()).child('buyerId').val() === auth.uid && root.child('transactions').child(newData.child('transactionId').val()).child('status').val() === 'completed') )"
      }
    },

    "usernames": {
      "$username": {
        ".read": true,
        ".write": "auth != null && ( (!data.exists() && newData.val() === auth.uid) || (data.exists() && data.val() === auth.uid) || root.child('admins').child(auth.uid).exists() )",
        ".validate": "$username.matches(/^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$/) && (!newData.exists() || newData.isString())"
      }
    },

    "analyticsEvents": {
      ".read": "auth != null",
      "$eventId": {
        ".write": "!data.exists()"
      }
    }
  }
}